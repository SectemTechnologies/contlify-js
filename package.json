{
  "name": "contlify",
  "version": "1.0.0",
  "description": "Standardized blog publishing engine and database adapter API framework for Next.js websites",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SectemTechnologies/Next.js-Package.git"
  },
  "bugs": {
    "url": "https://github.com/SectemTechnologies/Next.js-Package/issues"
  },
  "homepage": "https://github.com/SectemTechnologies/Next.js-Package#readme",
  "keywords": [
    "contlify",
    "cms",
    "publishing",
    "nextjs",
    "blog",
    "headless-cms",
    "api-adapter",
    "typescript"
  ],
  "author": "Sectem Technologies",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
